// {{.Entity}}Handler translates HTTP requests into domain service invocations for {{.HumanName}} operations.
type {{.Entity}}Handler struct {
	service  domain.{{.Entity}}Service
	validate *validator.Validate
	logger   *slog.Logger
}

// New{{.Entity}}Handler constructs a {{.Entity}}Handler with its dependencies injected via constructor.
func New{{.Entity}}Handler(service domain.{{.Entity}}Service, validate *validator.Validate, logger *slog.Logger) *{{.Entity}}Handler {
	return &{{.Entity}}Handler{
		service:  service,
		validate: validate,
		logger:   logger.With("component", "{{.FilePrefix}}_handler"),
	}
}

// RegisterRoutes registers all {{.Entity}} HTTP subroutes onto the provided Chi router.
func (h *{{.Entity}}Handler) RegisterRoutes(r chi.Router) {
	r.Route("/{{.Route}}", func(r chi.Router) {
{{- if .HasList}}
		r.Get("/", h.List{{.Plural}})
{{- end}}
{{- if .HasCreate}}
		r.Post("/", h.Create{{.Entity}})
{{- end}}
{{- if .HasGet}}
		r.Get("/{ {{- .IDParam -}} }", h.Get{{.Entity}})
{{- end}}
{{- if .HasUpdate}}
		r.Put("/{ {{- .IDParam -}} }", h.Update{{.Entity}})
{{- end}}
{{- if .HasDelete}}
		r.Delete("/{ {{- .IDParam -}} }", h.Delete{{.Entity}})
{{- end}}
{{- range .Custom}}
		{{- if .Permission}}
		// permission: {{.Permission}} (enforced once the rbac pack is added)
		{{- end}}
		r.MethodFunc("{{.HTTPMethod}}", "{{.Path}}", h.{{.GoMethod}})
{{- end}}
	})
}
{{if .NeedsIDParam}}
// parseID reads the {{.IDParam}} path parameter and answers 400 when it is not a valid id.
func (h *{{.Entity}}Handler) parseID(w http.ResponseWriter, r *http.Request) ({{.ID.GoType}}, bool) {
	raw := chi.URLParam(r, "{{.IDParam}}")
{{- if .ID.Auto}}
	id, err := strconv.ParseInt(raw, 10, 64)
	if err != nil || id <= 0 {
		RespondError(w, http.StatusBadRequest, "INVALID_PARAMETER", "{{.HumanName}} id must be a positive integer")
		return 0, false
	}
	return id, true
{{- else}}
	if err := h.validate.Var(raw, "required,uuid"); err != nil {
		RespondError(w, http.StatusBadRequest, "INVALID_PARAMETER", "{{.HumanName}} id must be a valid UUID")
		return "", false
	}
	return raw, true
{{- end}}
}
