{{- if .HasCreate}}
// Create{{.Entity}} handles POST /api/v1/{{.Route}}.
{{- if .Swagger}}
//
// @Summary      Create a {{.HumanName}}
// @Tags         {{.Tag}}
// @Accept       json
// @Produce      json
// @Param        request  body      domain.Create{{.Entity}}Request  true  "{{.Entity}} to create"
// @Success      201      {object}  SuccessResponse{data=domain.{{.Entity}}}
// @Failure      400      {object}  ErrorResponse
// @Failure      409      {object}  ErrorResponse
// @Failure      422      {object}  ErrorResponse
// @Failure      500      {object}  ErrorResponse
// @Router       /{{.Route}} [post]
{{- end}}
func (h *{{.Entity}}Handler) Create{{.Entity}}(w http.ResponseWriter, r *http.Request) {
	var req domain.Create{{.Entity}}Request
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		RespondError(w, http.StatusBadRequest, "INVALID_JSON", "malformed request payload")
		return
	}

	if err := h.validate.Struct(req); err != nil {
		RespondValidationError(w, "request payload validation failed", validationDetails(err))
		return
	}

	item, err := h.service.Create{{.Entity}}(r.Context(), req)
	if err != nil {
		respondDomainError(w, r, h.logger, err, "{{.HumanName}}")
		return
	}

	RespondSuccess(w, http.StatusCreated, item)
}
{{end}}
