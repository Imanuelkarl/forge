func (h *{{.Entity}}Handler) List{{.Plural}}(w http.ResponseWriter, r *http.Request) {
	items, meta, err := h.service.List{{.Plural}}(r.Context(), parseListParams(r))
	if err != nil {
		respondDomainError(w, r, h.logger, err, "{{.HumanName}}")
		return
	}

	RespondList(w, http.StatusOK, items, meta)
}
