// @Router       /{{.Route}}/{ {{- .IDParam -}} } [put]
{{- end}}
func (h *{{.Entity}}Handler) Update{{.Entity}}(w http.ResponseWriter, r *http.Request) {
	id, ok := h.parseID(w, r)
	if !ok {
		return
	}

	var req domain.Update{{.Entity}}Request
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		RespondError(w, http.StatusBadRequest, "INVALID_JSON", "malformed request payload")
		return
	}

	if err := h.validate.Struct(req); err != nil {
		RespondValidationError(w, "request payload validation failed", validationDetails(err))
		return
	}

	item, err := h.service.Update{{.Entity}}(r.Context(), id, req)
	if err != nil {
		respondDomainError(w, r, h.logger, err, "{{.HumanName}}")
		return
	}

	RespondSuccess(w, http.StatusOK, item)
}
