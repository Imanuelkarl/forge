// @Param        {{.IDParam}}  path      {{.ID.SwaggerType}}  true  "{{.Entity}} ID"
// @Success      200  {object}  SuccessResponse{data=domain.{{.Entity}}}
// @Failure      404  {object}  ErrorResponse
// @Failure      500  {object}  ErrorResponse
// @Router       /{{.Route}}/{ {{- .IDParam -}} } [get]
{{- end}}
func (h *{{.Entity}}Handler) Get{{.Entity}}(w http.ResponseWriter, r *http.Request) {
	id, ok := h.parseID(w, r)
	if !ok {
		return
	}

	item, err := h.service.Get{{.Entity}}ByID(r.Context(), id)
	if err != nil {
		respondDomainError(w, r, h.logger, err, "{{.HumanName}}")
		return
	}

	RespondSuccess(w, http.StatusOK, item)
}
