func Test{{.Entity}}Service_Create(t *testing.T) {
	svc := new{{.Entity}}TestService()

	item, err := svc.Create{{.Entity}}(context.Background(), sampleCreate{{.Entity}}Request())
	if err != nil {
		t.Fatalf("expected no error, got: %v", err)
	}
	if item.ID == {{.ID.Zero}} {
		t.Errorf("expected a generated ID, got the zero value")
	}
	if item.CreatedAt.IsZero() || item.UpdatedAt.IsZero() {
		t.Errorf("expected timestamps to be set")
	}
}

func Test{{.Entity}}Service_GetByID(t *testing.T) {
	ctx := context.Background()
	svc := new{{.Entity}}TestService()

	created, err := svc.Create{{.Entity}}(ctx, sampleCreate{{.Entity}}Request())
	if err != nil {
		t.Fatalf("setup failed: %v", err)
	}

	t.Run("found", func(t *testing.T) {
		found, err := svc.Get{{.Entity}}ByID(ctx, created.ID)
		if err != nil {
			t.Fatalf("expected to find {{.HumanName}}, got error: %v", err)
		}
		if found.ID != created.ID {
			t.Errorf("expected ID %v, got %v", created.ID, found.ID)
		}
	})

	t.Run("not found", func(t *testing.T) {
		_, err := svc.Get{{.Entity}}ByID(ctx, {{.ID.Missing}})
		if !errors.Is(err, domain.ErrNotFound) {
			t.Fatalf("expected ErrNotFound, got %v", err)
		}
	})
}

func Test{{.Entity}}Service_List(t *testing.T) {
	ctx := context.Background()
	svc := new{{.Entity}}TestService()

	if _, err := svc.Create{{.Entity}}(ctx, sampleCreate{{.Entity}}Request()); err != nil {
		t.Fatalf("setup failed: %v", err)
	}

	items, meta, err := svc.List{{.Plural}}(ctx, domain.ListParams{})
	if err != nil {
		t.Fatalf("expected no error, got: %v", err)
	}
	if len(items) != 1 || meta.Total != 1 {
		t.Errorf("expected 1 item and total 1, got %d items, total %d", len(items), meta.Total)
	}
	if meta.Page != 1 || meta.Limit != domain.DefaultLimit {
		t.Errorf("expected default pagination, got page=%d limit=%d", meta.Page, meta.Limit)
	}
}
