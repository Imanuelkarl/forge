func Test{{.Entity}}Service_Delete(t *testing.T) {
	ctx := context.Background()
	svc := new{{.Entity}}TestService()

	created, err := svc.Create{{.Entity}}(ctx, sampleCreate{{.Entity}}Request())
	if err != nil {
		t.Fatalf("setup failed: %v", err)
	}

	if err := svc.Delete{{.Entity}}(ctx, created.ID); err != nil {
		t.Fatalf("expected no error, got: %v", err)
	}
	if _, err := svc.Get{{.Entity}}ByID(ctx, created.ID); !errors.Is(err, domain.ErrNotFound) {
		t.Fatalf("expected ErrNotFound after delete, got %v", err)
	}
	if err := svc.Delete{{.Entity}}(ctx, created.ID); !errors.Is(err, domain.ErrNotFound) {
		t.Fatalf("expected ErrNotFound on second delete, got %v", err)
	}
}
