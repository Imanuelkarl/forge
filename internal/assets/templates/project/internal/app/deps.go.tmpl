// Package app wires modules and middleware into the HTTP router.
//
// modules_gen.go and middleware_gen.go are regenerated by `goforge sync`; deps.go is yours.
package app

import (
	"database/sql"
	"log/slog"

	"github.com/go-playground/validator/v10"
)

// Deps bundles the shared infrastructure every module needs.
// Add new shared dependencies here (cache, mailer, queue, ...) and they become
// available to the generated wiring.
type Deps struct {
	DB       *sql.DB
	Logger   *slog.Logger
	Validate *validator.Validate
}
