// Package handlers implements HTTP routing and handler registration.
package handlers

import (
	"log/slog"
	"time"

	"github.com/go-chi/chi/v5"
	chimiddleware "github.com/go-chi/chi/v5/middleware"
	"github.com/go-chi/cors"
{{- if .Swagger}}
	httpSwagger "github.com/swaggo/http-swagger/v2"
{{- end}}

	custommiddleware "{{.Module}}/internal/middleware"
)

// RouterOptions configures NewRouter. Module routes come from the Handler, so this file
// never needs editing when modules or middleware are added.
type RouterOptions struct {
	// Global registers extra global middleware (generated by goforge from forge.yaml).
	Global func(r chi.Router)

	// EnableDocs mounts the Swagger UI at /swagger/index.html.
	EnableDocs bool
}

// NewRouter constructs and configures the main Chi HTTP router for the service.
//
// Middleware Execution Order:
//  1. RequestID: Injects a unique trace ID into context & headers.
//  2. RealIP: Parses client IP from reverse proxy headers (e.g. X-Forwarded-For).
//  3. StructuredLogger: Emits structured slog logs with latency and status code.
//  4. Recoverer: Catches panics, logs stack traces, and returns a clean 500 error.
//  5. Timeout: Sets a context cancellation deadline (60s) on long-running requests.
//  6. CORS: Configures allowed origins, verbs, and headers for web clients.
//  7. Generated middleware from forge.yaml (opts.Global).
//
// h holds every handler in the application (see handler_gen.go); build it with app.NewHandler.
func NewRouter(logger *slog.Logger, h *Handler, corsOrigins []string, opts RouterOptions) *chi.Mux {
	r := chi.NewRouter()

	// ── 1. Global Middleware Stack ──────────────────────────────────────
	r.Use(custommiddleware.RequestID)
	r.Use(chimiddleware.RealIP)
	r.Use(custommiddleware.StructuredLogger(logger))
	r.Use(chimiddleware.Recoverer)
	r.Use(chimiddleware.Timeout(60 * time.Second))

	// ── 2. Cross-Origin Resource Sharing (CORS) ─────────────────────────
	r.Use(cors.Handler(cors.Options{
		AllowedOrigins:   corsOrigins,
		AllowedMethods:   []string{"GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"},
		AllowedHeaders:   []string{"Accept", "Authorization", "Content-Type", "X-Request-ID"},
		ExposedHeaders:   []string{"X-Request-ID"},
		AllowCredentials: true,
		MaxAge:           300, // Preflight cache duration in seconds
	}))

	// ── 3. Project middleware (generated) ───────────────────────────────
	if opts.Global != nil {
		opts.Global(r)
	}

	// ── 4. Public Health & Observability Endpoints ──────────────────────
	if h.Health != nil {
		r.Get("/health", h.Health.Health) // Liveness probe
		r.Get("/readyz", h.Health.Ready)  // Readiness probe
	}
{{- if .Swagger}}

	if opts.EnableDocs {
		r.Get("/swagger/*", httpSwagger.WrapHandler)
	}
{{- end}}

	// ── 5. API Version 1 Subroutes ──────────────────────────────────────
	r.Route("/api/v1", h.registerAPIRoutes)

	return r
}
