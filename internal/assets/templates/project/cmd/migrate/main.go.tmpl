// Command migrate applies the SQL migrations in ./migrations using golang-migrate.
//
// It reads DATABASE_URL from the environment (or .env) exactly like the server does,
// so `make migrate-up`, `goforge migrate up` and `go run ./cmd/migrate up` are equivalent.
package main

import (
	"errors"
	"fmt"
	"os"
	"path/filepath"
	"regexp"
	"strconv"
	"strings"
	"time"

	"github.com/golang-migrate/migrate/v4"
	_ "{{.MigrateImport}}"
	_ "github.com/golang-migrate/migrate/v4/source/file"

	"{{.Module}}/internal/config"
)

const migrationsDir = "migrations"

const usage = `usage: migrate <command> [args]

commands:
  up [n]          apply all pending migrations (or the next n)
  down [n|all]    roll back the last migration (default 1), n migrations, or all
  goto <version>  migrate up or down to a specific version
  force <version> set the version without running migrations (clears a dirty state)
  status          print the current version and dirty flag
  create <name>   create an empty <timestamp>_<name>.up.sql / .down.sql pair
`

func main() {
	if len(os.Args) < 2 {
		fmt.Fprint(os.Stderr, usage)
		os.Exit(2)
	}

	if err := run(os.Args[1], os.Args[2:]); err != nil {
		fmt.Fprintln(os.Stderr, "migrate:", err)
		os.Exit(1)
	}
}

func run(cmd string, args []string) error {
	switch cmd {
	case "create":
		return create(args)
	case "up", "down", "goto", "force", "status", "version":
	default:
		fmt.Fprint(os.Stderr, usage)
		return fmt.Errorf("unknown command %q", cmd)
	}

	cfg, err := config.Load()
	if err != nil {
		return err
	}

	m, err := migrate.New("file://"+migrationsDir, cfg.DatabaseURL)
	if err != nil {
		return fmt.Errorf("open migrations: %w", err)
	}
	defer func() { _, _ = m.Close() }()

	switch cmd {
	case "up":
		if len(args) > 0 {
			n, err := strconv.Atoi(args[0])
			if err != nil || n < 1 {
				return fmt.Errorf("up: %q is not a positive number", args[0])
			}
			err = m.Steps(n)
			return report(err, "migrated up")
		}
		return report(m.Up(), "migrated up")

	case "down":
		if len(args) > 0 && args[0] == "all" {
			return report(m.Down(), "rolled back all migrations")
		}
		n := 1
		if len(args) > 0 {
			parsed, err := strconv.Atoi(args[0])
			if err != nil || parsed < 1 {
				return fmt.Errorf("down: %q is not a positive number", args[0])
			}
			n = parsed
		}
		return report(m.Steps(-n), "rolled back")

	case "goto":
		v, err := parseVersion(args)
		if err != nil {
			return err
		}
		return report(m.Migrate(v), fmt.Sprintf("migrated to version %d", v))

	case "force":
		v, err := parseVersion(args)
		if err != nil {
			return err
		}
		if err := m.Force(int(v)); err != nil { //nolint:gosec // versions are timestamps well within int range
			return err
		}
		fmt.Printf("forced version %d\n", v)
		return nil

	default: // status, version
		v, dirty, err := m.Version()
		if errors.Is(err, migrate.ErrNilVersion) {
			fmt.Println("no migrations applied yet")
			return nil
		}
		if err != nil {
			return err
		}
		fmt.Printf("version: %d  dirty: %t\n", v, dirty)
		return nil
	}
}

func report(err error, doneMsg string) error {
	switch {
	case err == nil:
		fmt.Println(doneMsg)
		return nil
	case errors.Is(err, migrate.ErrNoChange):
		fmt.Println("no change")
		return nil
	default:
		return err
	}
}

func parseVersion(args []string) (uint, error) {
	if len(args) != 1 {
		return 0, errors.New("expected exactly one <version> argument")
	}
	v, err := strconv.ParseUint(args[0], 10, 64)
	if err != nil {
		return 0, fmt.Errorf("invalid version %q: %w", args[0], err)
	}
	return uint(v), nil
}

var nonWord = regexp.MustCompile(`[^a-z0-9]+`)

func create(args []string) error {
	if len(args) == 0 {
		return errors.New("usage: migrate create <name>")
	}

	name := strings.Trim(nonWord.ReplaceAllString(strings.ToLower(strings.Join(args, "_")), "_"), "_")
	if name == "" {
		return errors.New("migration name must contain letters or digits")
	}

	if err := os.MkdirAll(migrationsDir, 0o750); err != nil {
		return err
	}

	version := time.Now().UTC().Format("20060102150405")
	for _, dir := range []string{"up", "down"} {
		path := filepath.Join(migrationsDir, fmt.Sprintf("%s_%s.%s.sql", version, name, dir))
		body := fmt.Sprintf("-- %s migration: %s\n", dir, name)

		f, err := os.OpenFile(path, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o600) //nolint:gosec // path is built from sanitized input
		if err != nil {
			return err
		}
		if _, err := f.WriteString(body); err != nil {
			_ = f.Close()
			return err
		}
		if err := f.Close(); err != nil {
			return err
		}
		fmt.Println("created", path)
	}
	return nil
}
