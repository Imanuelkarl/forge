// Package main is the application entry point for the {{.Name}} service.
//
// Responsibilities:
//  1. Configuration Loading: Read typed environment variables.
//  2. Logging Setup: Initialize standard library structured logging (log/slog).
//  3. Database: Open the connection pool and verify connectivity.
//  4. Dependency Injection: app.NewHandler (generated) builds every handler.
//  5. Routing: Initialize the Chi HTTP router and register global middleware.
//  6. Server Lifecycle: Start the HTTP server on a background goroutine.
//  7. Graceful Shutdown: Capture OS termination signals (SIGINT, SIGTERM) and allow
//     in-flight requests to complete before terminating.
package main

import (
	"context"
	"fmt"
	"log/slog"
	"net/http"
	"os"
	"os/signal"
	"syscall"
	"time"

	"github.com/go-playground/validator/v10"

{{- if .Swagger}}

	_ "{{.Module}}/docs"
{{- end}}
	"{{.Module}}/internal/app"
	"{{.Module}}/internal/config"
	"{{.Module}}/internal/database"
	"{{.Module}}/internal/handlers"
)
{{if .Swagger}}
// @title           {{.Name}} API
// @version         1.0
// @description     HTTP API for {{.Name}}.
// @BasePath        /api/v1
{{- end}}
func main() {
	// ── 1. Load Configuration ───────────────────────────────────────────
	cfg, err := config.Load()
	if err != nil {
		slog.Error("failed to load configuration", "error", err)
		os.Exit(1)
	}

	// ── 2. Initialize Structured Logger (slog) ──────────────────────────
	logger := initLogger(cfg)
	slog.SetDefault(logger)

	logger.Info("starting service", "env", cfg.Env, "port", cfg.Port)

	// ── 3. Database ─────────────────────────────────────────────────────
	db, err := database.Open(context.Background(), cfg)
	if err != nil {
		logger.Error("failed to connect to database", "error", err)
		os.Exit(1)
	}

	// ── 4. Dependency Injection ─────────────────────────────────────────
	h := app.NewHandler(app.Deps{
		DB:       db,
		Logger:   logger,
		Validate: validator.New(),
	})

	// ── 5. Router ───────────────────────────────────────────────────────
	router := handlers.NewRouter(logger, h, cfg.CORSAllowedOrigins, handlers.RouterOptions{
		Global:     app.RegisterGlobalMiddleware,
		EnableDocs: !cfg.IsProduction(),
	})

	// ── 6. HTTP Server ──────────────────────────────────────────────────
	server := &http.Server{
		Addr:              fmt.Sprintf(":%d", cfg.Port),
		Handler:           router,
		ReadHeaderTimeout: 10 * time.Second,
	}

	serverErrors := make(chan error, 1)
	go func() {
		logger.Info("http server listening", "addr", server.Addr)
		serverErrors <- server.ListenAndServe()
	}()

	// ── 7. Graceful Shutdown ────────────────────────────────────────────
	stop := make(chan os.Signal, 1)
	signal.Notify(stop, os.Interrupt, syscall.SIGTERM)

	select {
	case err := <-serverErrors:
		logger.Error("server encountered an unexpected error", "error", err)
	case sig := <-stop:
		logger.Info("shutdown signal intercepted", "signal", sig.String())
	}

	ctx, cancel := context.WithTimeout(context.Background(), cfg.ShutdownTimeout)
	defer cancel()

	logger.Info("shutting down http server", "timeout", cfg.ShutdownTimeout.String())
	shutdownErr := server.Shutdown(ctx)

	if err := db.Close(); err != nil {
		logger.Error("error closing database pool", "error", err)
	}

	if shutdownErr != nil {
		logger.Error("server forced to shutdown due to error", "error", shutdownErr)
		os.Exit(1)
	}

	logger.Info("server shutdown completed successfully")
}

// initLogger constructs a configured *slog.Logger instance:
//   - In production: Uses JSONHandler for integration with Datadog/CloudWatch/ELK.
//   - In development: Uses TextHandler with source line information.
func initLogger(cfg *config.Config) *slog.Logger {
	var level slog.Level
	switch cfg.LogLevel {
	case "debug":
		level = slog.LevelDebug
	case "info":
		level = slog.LevelInfo
	case "warn":
		level = slog.LevelWarn
	case "error":
		level = slog.LevelError
	default:
		level = slog.LevelInfo
	}

	opts := &slog.HandlerOptions{
		Level:     level,
		AddSource: cfg.IsDevelopment(),
	}

	var handler slog.Handler
	if cfg.IsProduction() {
		handler = slog.NewJSONHandler(os.Stdout, opts)
	} else {
		handler = slog.NewTextHandler(os.Stdout, opts)
	}

	return slog.New(handler)
}
